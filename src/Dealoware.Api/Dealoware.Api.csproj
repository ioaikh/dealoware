<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Dealoware.Domain\Dealoware.Domain.csproj" />
    <ProjectReference Include="..\Dealoware.Application\Dealoware.Application.csproj" />
    <ProjectReference Include="..\Dealoware.Infrastructure\Dealoware.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <!-- The signed-in admin pages' files. Outside wwwroot on purpose: they are
       served only after the session gate (Program.cs, AdminSignedInPage). -->
  <ItemGroup>
    <Content Include="AdminAssets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The release's commit, built in (ReleaseVersion, the health answers). The image build
       sets it from the Dockerfile's GIT_SHA build argument; any other build answers "dev". -->
  <PropertyGroup>
    <DealowareGitSha Condition="'$(DealowareGitSha)' == ''">dev</DealowareGitSha>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DealowareGitSha" Value="$(DealowareGitSha)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
