<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Dealoware.Domain\Dealoware.Domain.csproj" />
    <ProjectReference Include="..\Dealoware.Application\Dealoware.Application.csproj" />
    <ProjectReference Include="..\Dealoware.Infrastructure\Dealoware.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Admin\Ui\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Local Playwright seed only. Never ships in Release / production binaries. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Admin\AdminUiTestHarness.cs" />
  </ItemGroup>

</Project>
