		{
			"name": "02-Create-Negotiation",
			"item": [
				{
					"name": "Create Negotiation (Seller initiates)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Create returns negotiation ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData.id).to.not.be.empty;",
									"});",
									"",
									"pm.test(\"Negotiation status is Open\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('Open');",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"negotiationId\", jsonData.id);",
									"console.log(\"Negotiation created - ID: \" + jsonData.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "ApiKey {{sellerApiKey}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"artifactId\": \"{{artifactId}}\",\n  \"counterpartyParticipantId\": \"{{buyerSub}}\",\n  \"callerIntent\": \"sell\",\n  \"counterpartyIntent\": \"buy\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/negotiations",
							"host": ["{{baseUrl}}"],
							"path": ["negotiations"]
						},
						"description": "Create negotiation. Contract: Create still returns an id. Captures negotiationId."
					},
					"response": []
				},
				{
					"name": "Counterparty GETs Negotiation (Buyer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Counterparty can GET negotiation by ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.eql(pm.collectionVariables.get('negotiationId'));",
									"});",
									"",
									"pm.test(\"Intents are correct\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.partyAIntent).to.eql('sell');",
									"    pm.expect(jsonData.partyBIntent).to.eql('buy');",
									"});",
									"",
									"console.log(\"Counterparty successfully retrieved negotiation\");"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "ApiKey {{buyerApiKey}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/negotiations/{{negotiationId}}",
							"host": ["{{baseUrl}}"],
							"path": ["negotiations", "{{negotiationId}}"]
						},
						"description": "Contract: The other Participant can GET it."
					},
					"response": []
				}
			],
			"description": "Create negotiation and verify counterparty can GET it."
		},
