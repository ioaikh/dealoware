package-lock.json
# Allow e2e lockfile for pinned Playwright dependencies
!e2e/package-lock.json
# Setup-page Playwright has its own pinned lockfile (see e2e/bootstrap/run.sh)
!e2e/bootstrap/package-lock.json
e2e/bootstrap/test-results/
# Sign-in pages Playwright, the same way (see e2e/sign-in/run.sh)
!e2e/sign-in/package-lock.json
e2e/sign-in/test-results/
# Authenticator set-up pages Playwright, the same way (see e2e/enrol/run.sh)
!e2e/enrol/package-lock.json
e2e/enrol/test-results/
# Password-reset pages Playwright, the same way (see e2e/reset/run.sh)
!e2e/reset/package-lock.json
e2e/reset/test-results/
# Signed-in console shell Playwright, the same way (see e2e/console/run.sh)
!e2e/console/package-lock.json
e2e/console/test-results/
